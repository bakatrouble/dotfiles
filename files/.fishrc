# vim: set filetype=fish :

# Global-alias style pipe shortcuts (zsh's `alias -g`): type the word, then Space.
gabbr G '| grep'
gabbr GI '| grep -i'
gabbr L '| less'
gabbr H '| head'
gabbr T '| tail'
gabbr WC '| wc'
gabbr S '| sort'
gabbr U '| uniq'
gabbr B '| bat'
set -g fish_key_bindings fish_default_key_bindings
