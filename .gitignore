# Runtime state written by fish; never tracked
**/fish_variables*
*.bak

# fisher plugins: everything directly in these directories is installed by plugins.
# Our own files are whitelisted below.
fish/.config/fish/functions/*
fish/.config/fish/conf.d/*
fish/.config/fish/completions/*
fish/.config/fish/themes/*

# Our functions: everything under functions/custom is ours.
!fish/.config/fish/functions/custom/

!fish/.config/fish/functions/fisher.fish

!fish/.config/fish/conf.d/00-functions.fish
!fish/.config/fish/conf.d/10-env.fish
!fish/.config/fish/conf.d/30-tide.fish
!fish/.config/fish/conf.d/unity-cli.fish

!fish/.config/fish/completions/copilot.fish
!fish/.config/fish/completions/fisher.fish
!fish/.config/fish/completions/uv.fish
!fish/.config/fish/completions/uvx.fish

# Machine-local mise config (desktop-only services, origins); never shared.
*.local.toml

# Personal git identity; not published.
/git/

# Private SSH host blocks: linked to ~/.ssh/hosts.d, never published.
ssh/hosts.d/*
!.gitkeep
