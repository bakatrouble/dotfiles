# Runtime state written by fish; never tracked
**/fish_variables*
*.bak


# fisher plugins: everything directly in these directories is installed by plugins.
# Our own files are whitelisted below.
files/config/fish/functions/*
files/config/fish/conf.d/*
files/config/fish/completions/*
files/config/fish/themes/*

# Our functions: everything under functions/custom is ours.
!files/config/fish/functions/custom/

!files/config/fish/functions/fisher.fish

!files/config/fish/conf.d/00-functions.fish
!files/config/fish/conf.d/10-env.fish
!files/config/fish/conf.d/30-tide.fish
!files/config/fish/conf.d/unity-cli.fish

!files/config/fish/completions/copilot.fish
!files/config/fish/completions/fisher.fish
!files/config/fish/completions/uv.fish
!files/config/fish/completions/uvx.fish

# Private SSH host blocks: linked to ~/.ssh/hosts.d, never published.
files/ssh/hosts.d/*
!files/ssh/hosts.d/.gitkeep
